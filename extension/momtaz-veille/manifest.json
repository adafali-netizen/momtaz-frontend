{
  "manifest_version": 3,
  "name": "Momtaz Veille",
  "version": "1.0.0",
  "description": "Relève les publicités de l'Ad Library Facebook pour le module Veille de l'ERP Momtaz. À utiliser dans un profil Chrome non connecté à Facebook.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/ads/library/*", "https://web.facebook.com/ads/library/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["collector.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.vercel.app/*", "http://localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Momtaz Veille", "default_popup": "popup.html" }
}
